# ===========================
# Étape 1 : Build de l’application avec le SDK .NET 8.0
# ===========================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Supprime les caches NuGet pour éviter les erreurs
RUN dotnet nuget locals all --clear

# Copie uniquement le fichier .csproj et restauration des dépendances
COPY ["Api.PrinterProd/Api.PrinterProd.csproj", "./Api.PrinterProd/"]
WORKDIR /src/Api.PrinterProd
RUN dotnet restore --disable-parallel --ignore-failed-sources

# Copie du reste des fichiers et compilation en mode Release
COPY . . 
RUN dotnet publish "Api.PrinterProd/Api.PrinterProd.csproj" -c Release -p:TreatWarningsAsErrors=false -o /app/publish

# ===========================
# Étape 2 : Exécution avec l'image .NET Runtime pour alléger l'image
# ===========================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# ✅ Étape 2.1 : Installation des outils nécessaires à la production
RUN apt-get update && apt-get install -y \
    smbclient \
    curl \
    iputils-ping \
    net-tools \
    procps \
    && rm -rf /var/lib/apt/lists/*  # Nettoyage pour réduire la taille de l'image

# ✅ Copie uniquement les fichiers publiés du build
COPY --from=build /app/publish .

# ✅ Exposition du port de l’API
ENV ASPNETCORE_URLS=http://+:7001
EXPOSE 7001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
    CMD curl --fail --silent http://localhost:7001/swagger/index.html || exit 1

# ✅ Lancement de l’application en mode production
CMD ["dotnet", "Api.PrinterProd.dll"]
